# ── Stripe keys ───────────────────────────────────────────────
# Test mode while developing (sk_test_... / pk_test_...).
# Switch to live keys (sk_live_... / pk_live_...) only on production.
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Optional — used by /api/webhook to verify Stripe events.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Stripe price IDs ──────────────────────────────────────────
# Create the products at https://dashboard.stripe.com/products and
# paste each price ID below (format: price_...).
STRIPE_PRICE_MAIN=price_xxx       # ROUNDpops master checkout
STRIPE_PRICE_UPSELL_1=price_xxx   # Living Off Gourmet Popcorn — $37
STRIPE_PRICE_UPSELL_2=price_xxx   # Cash Flow Academy — $37
STRIPE_PRICE_UPSELL_3=price_xxx   # Sweet Academy — $97

# ── App URL ───────────────────────────────────────────────────
# Used to build Stripe return_url/cancel_url. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
